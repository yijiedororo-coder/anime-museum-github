{
  "name": "anime-museum",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "动画博物馆：作品、活动、角色与周边资料库",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "node tools/verify.mjs",
    "build": "node tools/verify.mjs && node tools/build.mjs",
    "preview": "node tools/preview.mjs",
    "start": "node tools/preview.mjs",
    "deploy:pages": "npm run build && wrangler pages deploy dist --config wrangler.pages.toml",
    "deploy:workers": "npm run build && wrangler deploy",
    "deploy:check": "wrangler deploy --dry-run"
  },
  "devDependencies": {
    "wrangler": "4.151.3"
  }
}
